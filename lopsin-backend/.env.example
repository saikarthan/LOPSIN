# ---- Lopsin backend configuration ----
PORT=8080
NODE_ENV=development

# Secret used to sign dashboard JWTs and agent enrollment tokens.
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-in-production-0a1b2c3d4e5f
TOKEN_TTL_HOURS=12

# ---- Data layer ----
# Leave MONGODB_URI empty to use the embedded JSON document store (./data/lopsin.json).
# Set it to a MongoDB / Atlas connection string to use MongoDB instead. Nothing else changes.
# MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_URI=
MONGODB_DB=lopsin
FILE_DB_PATH=./data/lopsin.json

# ---- Zero-data-access guard ----
# STRICT rejects any ingested signal that looks like customer data / PII.
PRIVACY_GUARD=STRICT

# ---- AI remediation advisor (optional) ----
# Comma-separated provider keys. Leave empty to use the built-in catalog guidance.
LLM_PROVIDER=groq
LLM_MODEL=openai/gpt-oss-120b
LLM_API_KEYS=
